{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "next/core-web-vitals",
    "prettier"
  ],
  "ignorePatterns": ["**/public/**/*", "out/**/*"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "react",
    "@typescript-eslint",
    "@next/eslint-plugin-next",
    "prettier"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ],
    "no-import-assign": "error",
    "no-unreachable": "error",
    "@next/next/no-img-element": "off",
    "react/jsx-no-target-blank": "off"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
