{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "sourceMap": true,
    "outDir": "./.local/vite/dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./src",
    "paths": {
      "@fseehawer/react-circular-slider": ["typings/react-circular-slider.d.ts"], // This is an override for the react-circular-slider package because it throws a tsc error.
      "@automerge/automerge/automerge.wasm.base64.js": [
        "../node_modules/@automerge/automerge/dist/mjs/wasm_bindgen_output/web/automerge_wasm_bg_base64.js"
      ],
    },
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "types": ["node", "vitest/globals"],

    "skipLibCheck": false /* Skip type checking all .d.ts files. */,

    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "strictFunctionTypes": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false, // requires strictNullChecks=true
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".local", "public", "static"]
}
