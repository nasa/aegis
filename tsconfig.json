{
  "compilerOptions": {
    "target": "es2022",
    "jsx": "react-jsx",
    "module": "es2022",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./.local/vite/dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "types": ["node", "jest", "@testing-library/jest-dom"],

    "skipLibCheck": true /* Skip type checking all .d.ts files. */,

    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "strictFunctionTypes": false, // causes type check errors = 81
    "strictNullChecks": false, // causes type check errors = 876
    "strictPropertyInitialization": false, // requires strictNullChecks=true, increased errors = 41
    "noEmit": true,
    "isolatedModules": true,
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".local", "public", "static"]
}
