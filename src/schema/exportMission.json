{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "ActionTemplate": {
            "allOf": [
                {
                    "$ref": "#/definitions/Partial<Action>"
                },
                {
                    "properties": {
                        "templateName": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "templateName",
                        "type",
                        "uuid"
                    ],
                    "type": "object"
                }
            ]
        },
        "Crew": {
            "enum": [
                "EV1",
                "EV2"
            ],
            "type": "string"
        },
        "EquipmentItem": {
            "description": "Equipment item",
            "properties": {
                "name": {
                    "type": "string"
                },
                "quantity": {
                    "type": "number"
                },
                "singleUse": {
                    "type": "boolean"
                },
                "uuid": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "quantity",
                "singleUse",
                "uuid"
            ],
            "type": "object"
        },
        "GeographicUnit": {
            "description": "Geographic unit",
            "properties": {
                "abbr": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "uuid": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "uuid"
            ],
            "type": "object"
        },
        "Partial<Action>": {
            "properties": {
                "actionDefinition": {
                    "anyOf": [
                        {
                            "properties": {
                                "adjectiveUuid": {
                                    "type": "string"
                                },
                                "nounUuid": {
                                    "type": "string"
                                },
                                "verbUuid": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "adjectiveUuid",
                                "nounUuid",
                                "verbUuid"
                            ],
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "createdAt": {
                    "type": "string"
                },
                "crewAssigned": {
                    "items": {
                        "$ref": "#/definitions/Crew"
                    },
                    "type": "array"
                },
                "description": {
                    "description": "Science explanation of details of the action. e.g. \"Photograph contact point between two units.\"",
                    "type": "string"
                },
                "durationLower": {
                    "type": "number"
                },
                "durationUpper": {
                    "type": "number"
                },
                "elevation": {
                    "type": [
                        "null",
                        "number"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                },
                "equipmentItemsUsage": {
                    "anyOf": [
                        {
                            "items": {
                                "description": "Equipment needed to perform an action.",
                                "properties": {
                                    "quantityUsed": {
                                        "type": "number"
                                    },
                                    "uuid": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "quantityUsed",
                                    "uuid"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "geographicUnitsUsage": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "icon": {
                    "description": "The duration of the action, in minutes.",
                    "type": "string"
                },
                "location": {
                    "anyOf": [
                        {
                            "description": "Basic concept of a point",
                            "properties": {
                                "alt": {
                                    "type": "number"
                                },
                                "lat": {
                                    "type": "number"
                                },
                                "lng": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "lat",
                                "lng"
                            ],
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The coordinates or series of coordinates of the Action."
                },
                "mass": {
                    "type": "number"
                },
                "missionId": {
                    "type": [
                        "null",
                        "number"
                    ]
                },
                "name": {
                    "type": "string"
                },
                "parentActionUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "parentCopyDate": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "poiUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "priority": {
                    "type": [
                        "null",
                        "number"
                    ]
                },
                "stationUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "status": {
                    "anyOf": [
                        {
                            "enum": [
                                "Approved",
                                "Archived",
                                "Candidate",
                                "In Review"
                            ],
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "stmAction": {
                    "type": "boolean"
                },
                "stmPriorities": {
                    "anyOf": [
                        {
                            "additionalProperties": {
                                "type": "number"
                            },
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "stmUuidRefs": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Allow linkage to any part of the STM hierarchy"
                },
                "traverseUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "type": {
                    "description": "The type of action to be taken",
                    "enum": [
                        "chip",
                        "double drive tube",
                        "drive tube",
                        "float",
                        "measurement",
                        "observation",
                        "other",
                        "photo",
                        "rake",
                        "sample",
                        "scoop",
                        "sealed scoop",
                        "trench"
                    ],
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                },
                "uuid": {
                    "description": "uuid of the action",
                    "type": "string"
                }
            },
            "type": "object"
        }
    },
    "properties": {
        "_metadata": {
            "type": "string"
        },
        "actionDefinitions": {
            "anyOf": [
                {
                    "properties": {
                        "adjectives": {
                            "items": {
                                "properties": {
                                    "abbr": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "uuid": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "abbr",
                                    "name",
                                    "uuid"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        "nouns": {
                            "items": {
                                "properties": {
                                    "abbr": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "uuid": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "abbr",
                                    "name",
                                    "uuid"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        "verbs": {
                            "items": {
                                "properties": {
                                    "abbr": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "uuid": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "abbr",
                                    "name",
                                    "uuid"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        }
                    },
                    "required": [
                        "adjectives",
                        "nouns",
                        "verbs"
                    ],
                    "type": "object"
                },
                {
                    "type": "null"
                }
            ]
        },
        "actionSystemVersion": {
            "type": "number"
        },
        "actionTemplates": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/definitions/ActionTemplate"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "activeGridUuid": {
            "type": [
                "null",
                "string"
            ]
        },
        "circleDefinitions": {
            "anyOf": [
                {
                    "items": {
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "radius": {
                                "type": "number"
                            },
                            "uuid": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "name",
                            "radius",
                            "uuid"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "createdAt": {
            "type": "string"
        },
        "defaultEvaDuration": {
            "type": [
                "null",
                "number"
            ]
        },
        "demFilePath": {
            "type": "string"
        },
        "demResolution": {
            "type": [
                "null",
                "number"
            ]
        },
        "description": {
            "type": [
                "null",
                "string"
            ]
        },
        "equipmentItems": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/definitions/EquipmentItem"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "geographicUnits": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/definitions/GeographicUnit"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "id": {
            "type": "number"
        },
        "initialZoom": {
            "type": [
                "null",
                "number"
            ]
        },
        "isArchived": {
            "type": "boolean"
        },
        "landerElevationMeters": {
            "type": [
                "null",
                "number"
            ]
        },
        "landerLocation": {
            "description": "Basic concept of a point",
            "properties": {
                "alt": {
                    "type": "number"
                },
                "lat": {
                    "type": "number"
                },
                "lng": {
                    "type": "number"
                }
            },
            "required": [
                "lat",
                "lng"
            ],
            "type": "object"
        },
        "missionBanner": {
            "type": [
                "null",
                "string"
            ]
        },
        "name": {
            "type": "string"
        },
        "planetRadius": {
            "type": [
                "null",
                "number"
            ]
        },
        "projBoundsMaxX": {
            "type": [
                "null",
                "number"
            ]
        },
        "projBoundsMaxY": {
            "type": [
                "null",
                "number"
            ]
        },
        "projBoundsMinX": {
            "type": [
                "null",
                "number"
            ]
        },
        "projBoundsMinY": {
            "type": [
                "null",
                "number"
            ]
        },
        "projEpsg": {
            "type": "string"
        },
        "projIsCustom": {
            "type": "boolean"
        },
        "projOriginX": {
            "type": [
                "null",
                "number"
            ]
        },
        "projOriginY": {
            "type": [
                "null",
                "number"
            ]
        },
        "projProj4String": {
            "type": "string"
        },
        "projResUnitsPerPixel": {
            "type": [
                "null",
                "number"
            ]
        },
        "projResZoomLevel": {
            "type": [
                "null",
                "number"
            ]
        },
        "stmLevel1Enabled": {
            "type": "boolean"
        },
        "stmLevel1Name": {
            "type": "string"
        },
        "stmLevel2Name": {
            "type": "string"
        },
        "stmLevel3Name": {
            "type": "string"
        },
        "traverseRate": {
            "type": [
                "null",
                "number"
            ]
        },
        "updatedAt": {
            "type": "string"
        },
        "version": {
            "type": "number"
        },
        "walkbackRate": {
            "type": [
                "null",
                "number"
            ]
        }
    },
    "required": [
        "actionDefinitions",
        "actionSystemVersion",
        "actionTemplates",
        "activeGridUuid",
        "circleDefinitions",
        "defaultEvaDuration",
        "demFilePath",
        "demResolution",
        "description",
        "equipmentItems",
        "geographicUnits",
        "id",
        "initialZoom",
        "isArchived",
        "landerElevationMeters",
        "landerLocation",
        "missionBanner",
        "name",
        "planetRadius",
        "projBoundsMaxX",
        "projBoundsMaxY",
        "projBoundsMinX",
        "projBoundsMinY",
        "projEpsg",
        "projIsCustom",
        "projOriginX",
        "projOriginY",
        "projProj4String",
        "projResUnitsPerPixel",
        "projResZoomLevel",
        "traverseRate",
        "version",
        "walkbackRate"
    ],
    "type": "object"
}

