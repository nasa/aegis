{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "ActionDefinitionReadable": {
            "properties": {
                "adjective": {
                    "properties": {
                        "abbr": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "abbr",
                        "name",
                        "uuid"
                    ],
                    "type": "object"
                },
                "displayString": {
                    "type": "string"
                },
                "noun": {
                    "properties": {
                        "abbr": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "abbr",
                        "name",
                        "uuid"
                    ],
                    "type": "object"
                },
                "verb": {
                    "properties": {
                        "abbr": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "abbr",
                        "name",
                        "uuid"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "adjective",
                "displayString",
                "noun",
                "verb"
            ],
            "type": "object"
        },
        "ActionType": {
            "enum": [
                "chip",
                "double drive tube",
                "drive tube",
                "float",
                "measurement",
                "observation",
                "other",
                "photo",
                "rake",
                "sample",
                "scoop",
                "sealed scoop",
                "trench"
            ],
            "type": "string"
        },
        "Crew": {
            "enum": [
                "EV1",
                "EV2"
            ],
            "type": "string"
        },
        "StmPriorityReadable": {
            "properties": {
                "priority": {
                    "type": "number"
                },
                "uuid": {
                    "type": "string"
                }
            },
            "required": [
                "priority",
                "uuid"
            ],
            "type": "object"
        }
    },
    "properties": {
        "_itemType": {
            "type": "string"
        },
        "actionDefinition": {
            "anyOf": [
                {
                    "properties": {
                        "adjectiveUuid": {
                            "type": "string"
                        },
                        "nounUuid": {
                            "type": "string"
                        },
                        "verbUuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "adjectiveUuid",
                        "nounUuid",
                        "verbUuid"
                    ],
                    "type": "object"
                },
                {
                    "type": "null"
                }
            ]
        },
        "actionDefinitionReadable": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ActionDefinitionReadable"
                },
                {
                    "type": "null"
                }
            ]
        },
        "createdAt": {
            "type": "string"
        },
        "crewAssigned": {
            "items": {
                "$ref": "#/definitions/Crew"
            },
            "type": "array"
        },
        "description": {
            "description": "Science explanation of details of the action. e.g. \"Photograph contact point between two units.\"",
            "type": "string"
        },
        "descriptionReadable": {
            "type": "string"
        },
        "durationLower": {
            "type": "number"
        },
        "durationUpper": {
            "type": "number"
        },
        "elevation": {
            "type": [
                "null",
                "number"
            ]
        },
        "enabled": {
            "type": "boolean"
        },
        "equipmentItemsUsage": {
            "anyOf": [
                {
                    "items": {
                        "description": "Equipment needed to perform an action.",
                        "properties": {
                            "quantityUsed": {
                                "type": "number"
                            },
                            "uuid": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "quantityUsed",
                            "uuid"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "equipmentItemsUsageReadable": {
            "anyOf": [
                {
                    "items": {
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "quantityUsed": {
                                "type": "number"
                            },
                            "singleUse": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "name",
                            "quantityUsed",
                            "singleUse"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "geographicUnitsUsage": {
            "anyOf": [
                {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "geographicalUnitsReadable": {
            "anyOf": [
                {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "icon": {
            "description": "The duration of the action, in minutes.",
            "type": "string"
        },
        "iconEmojiDecoded": {
            "type": "string"
        },
        "location": {
            "anyOf": [
                {
                    "description": "Basic concept of a point",
                    "properties": {
                        "alt": {
                            "type": "number"
                        },
                        "lat": {
                            "type": "number"
                        },
                        "lng": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "lat",
                        "lng"
                    ],
                    "type": "object"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The coordinates or series of coordinates of the Action."
        },
        "mass": {
            "type": "number"
        },
        "missionId": {
            "type": [
                "null",
                "number"
            ]
        },
        "name": {
            "type": "string"
        },
        "parentActionUuid": {
            "type": [
                "null",
                "string"
            ]
        },
        "parentCopyDate": {
            "type": [
                "null",
                "string"
            ]
        },
        "parentPoiName": {
            "type": "string"
        },
        "parentStationName": {
            "type": "string"
        },
        "poiUuid": {
            "type": [
                "null",
                "string"
            ]
        },
        "priority": {
            "type": [
                "null",
                "number"
            ]
        },
        "stationUuid": {
            "type": [
                "null",
                "string"
            ]
        },
        "status": {
            "anyOf": [
                {
                    "enum": [
                        "Approved",
                        "Archived",
                        "Candidate",
                        "In Review"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ]
        },
        "stmAction": {
            "type": "boolean"
        },
        "stmPriorities": {
            "anyOf": [
                {
                    "additionalProperties": {
                        "type": "number"
                    },
                    "type": "object"
                },
                {
                    "type": "null"
                }
            ]
        },
        "stmPrioritiesReadable": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/definitions/StmPriorityReadable"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ]
        },
        "stmUuidRefs": {
            "anyOf": [
                {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Allow linkage to any part of the STM hierarchy"
        },
        "stmUuidRefsReadable": {
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "traverseUuid": {
            "type": [
                "null",
                "string"
            ]
        },
        "type": {
            "$ref": "#/definitions/ActionType",
            "description": "The type of action to be taken"
        },
        "updatedAt": {
            "type": "string"
        },
        "uuid": {
            "description": "uuid of the action",
            "type": "string"
        }
    },
    "required": [
        "_itemType",
        "actionDefinition",
        "actionDefinitionReadable",
        "crewAssigned",
        "description",
        "descriptionReadable",
        "durationLower",
        "elevation",
        "enabled",
        "equipmentItemsUsage",
        "equipmentItemsUsageReadable",
        "geographicUnitsUsage",
        "geographicalUnitsReadable",
        "icon",
        "iconEmojiDecoded",
        "location",
        "mass",
        "missionId",
        "name",
        "parentPoiName",
        "parentStationName",
        "priority",
        "status",
        "stmAction",
        "stmPriorities",
        "stmPrioritiesReadable",
        "stmUuidRefs",
        "stmUuidRefsReadable",
        "type",
        "uuid"
    ],
    "type": "object"
}

