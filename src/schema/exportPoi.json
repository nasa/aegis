{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "ActionDefinitionReadable": {
            "properties": {
                "adjective": {
                    "properties": {
                        "abbr": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "abbr",
                        "name",
                        "uuid"
                    ],
                    "type": "object"
                },
                "displayString": {
                    "type": "string"
                },
                "noun": {
                    "properties": {
                        "abbr": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "abbr",
                        "name",
                        "uuid"
                    ],
                    "type": "object"
                },
                "verb": {
                    "properties": {
                        "abbr": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "abbr",
                        "name",
                        "uuid"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "adjective",
                "displayString",
                "noun",
                "verb"
            ],
            "type": "object"
        },
        "ActionType": {
            "enum": [
                "chip",
                "double drive tube",
                "drive tube",
                "float",
                "measurement",
                "observation",
                "other",
                "photo",
                "rake",
                "sample",
                "scoop",
                "sealed scoop",
                "trench"
            ],
            "type": "string"
        },
        "Crew": {
            "enum": [
                "EV1",
                "EV2"
            ],
            "type": "string"
        },
        "ExportAction": {
            "properties": {
                "_itemType": {
                    "type": "string"
                },
                "actionDefinition": {
                    "anyOf": [
                        {
                            "properties": {
                                "adjectiveUuid": {
                                    "type": "string"
                                },
                                "nounUuid": {
                                    "type": "string"
                                },
                                "verbUuid": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "adjectiveUuid",
                                "nounUuid",
                                "verbUuid"
                            ],
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "actionDefinitionReadable": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/ActionDefinitionReadable"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "createdAt": {
                    "type": "string"
                },
                "crewAssigned": {
                    "items": {
                        "$ref": "#/definitions/Crew"
                    },
                    "type": "array"
                },
                "description": {
                    "description": "Science explanation of details of the action. e.g. \"Photograph contact point between two units.\"",
                    "type": "string"
                },
                "descriptionReadable": {
                    "type": "string"
                },
                "durationLower": {
                    "type": "number"
                },
                "durationUpper": {
                    "type": "number"
                },
                "elevation": {
                    "type": [
                        "null",
                        "number"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                },
                "equipmentItemsUsage": {
                    "anyOf": [
                        {
                            "items": {
                                "description": "Equipment needed to perform an action.",
                                "properties": {
                                    "quantityUsed": {
                                        "type": "number"
                                    },
                                    "uuid": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "quantityUsed",
                                    "uuid"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "equipmentItemsUsageReadable": {
                    "anyOf": [
                        {
                            "items": {
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "quantityUsed": {
                                        "type": "number"
                                    },
                                    "singleUse": {
                                        "type": "boolean"
                                    }
                                },
                                "required": [
                                    "name",
                                    "quantityUsed",
                                    "singleUse"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "geographicUnitsUsage": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "geographicalUnitsReadable": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "icon": {
                    "description": "The duration of the action, in minutes.",
                    "type": "string"
                },
                "iconEmojiDecoded": {
                    "type": "string"
                },
                "location": {
                    "anyOf": [
                        {
                            "description": "Basic concept of a point",
                            "properties": {
                                "alt": {
                                    "type": "number"
                                },
                                "lat": {
                                    "type": "number"
                                },
                                "lng": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "lat",
                                "lng"
                            ],
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The coordinates or series of coordinates of the Action."
                },
                "mass": {
                    "type": "number"
                },
                "missionId": {
                    "type": [
                        "null",
                        "number"
                    ]
                },
                "name": {
                    "type": "string"
                },
                "parentActionUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "parentCopyDate": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "parentPoiName": {
                    "type": "string"
                },
                "parentStationName": {
                    "type": "string"
                },
                "poiUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "priority": {
                    "type": [
                        "null",
                        "number"
                    ]
                },
                "stationUuid": {
                    "type": [
                        "null",
                        "string"
                    ]
                },
                "status": {
                    "anyOf": [
                        {
                            "enum": [
                                "Approved",
                                "Archived",
                                "Candidate",
                                "In Review"
                            ],
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "stmAction": {
                    "type": "boolean"
                },
                "stmPriorities": {
                    "anyOf": [
                        {
                            "additionalProperties": {
                                "type": "number"
                            },
                            "type": "object"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "stmPrioritiesReadable": {
                    "anyOf": [
                        {
                            "items": {
                                "$ref": "#/definitions/StmPriorityReadable"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "stmUuidRefs": {
                    "anyOf": [
                        {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Allow linkage to any part of the STM hierarchy"
                },
                "stmUuidRefsReadable": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "type": {
                    "$ref": "#/definitions/ActionType",
                    "description": "The type of action to be taken"
                },
                "updatedAt": {
                    "type": "string"
                },
                "uuid": {
                    "description": "uuid of the action",
                    "type": "string"
                }
            },
            "required": [
                "_itemType",
                "actionDefinition",
                "actionDefinitionReadable",
                "crewAssigned",
                "description",
                "descriptionReadable",
                "durationLower",
                "elevation",
                "enabled",
                "equipmentItemsUsage",
                "equipmentItemsUsageReadable",
                "geographicUnitsUsage",
                "geographicalUnitsReadable",
                "icon",
                "iconEmojiDecoded",
                "location",
                "mass",
                "missionId",
                "name",
                "parentPoiName",
                "parentStationName",
                "priority",
                "status",
                "stmAction",
                "stmPriorities",
                "stmPrioritiesReadable",
                "stmUuidRefs",
                "stmUuidRefsReadable",
                "type",
                "uuid"
            ],
            "type": "object"
        },
        "PoiCalculatedFields": {
            "allOf": [
                {
                    "properties": {
                        "reportItems": {
                            "items": {
                                "properties": {
                                    "message": {
                                        "type": "string"
                                    },
                                    "type": {
                                        "enum": [
                                            "error",
                                            "info",
                                            "warning"
                                        ],
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "message",
                                    "type"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        "uuid": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "reportItems",
                        "uuid"
                    ],
                    "type": "object"
                },
                {
                    "properties": {
                        "actionCount": {
                            "type": "number"
                        },
                        "totalActionTime": {
                            "properties": {
                                "durationLower": {
                                    "type": "number"
                                },
                                "durationUpper": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "durationLower",
                                "durationUpper"
                            ],
                            "type": "object"
                        },
                        "totalDwellTime": {
                            "properties": {
                                "durationLower": {
                                    "type": "number"
                                },
                                "durationUpper": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "durationLower",
                                "durationUpper"
                            ],
                            "type": "object"
                        },
                        "totalEv1Time": {
                            "properties": {
                                "durationLower": {
                                    "type": "number"
                                },
                                "durationUpper": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "durationLower",
                                "durationUpper"
                            ],
                            "type": "object"
                        },
                        "totalEv2Time": {
                            "properties": {
                                "durationLower": {
                                    "type": "number"
                                },
                                "durationUpper": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "durationLower",
                                "durationUpper"
                            ],
                            "type": "object"
                        },
                        "totalMass": {
                            "type": "number"
                        },
                        "totalUnassignedTime": {
                            "properties": {
                                "durationLower": {
                                    "type": "number"
                                },
                                "durationUpper": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "durationLower",
                                "durationUpper"
                            ],
                            "type": "object"
                        }
                    },
                    "required": [
                        "actionCount",
                        "totalActionTime",
                        "totalDwellTime",
                        "totalEv1Time",
                        "totalEv2Time",
                        "totalMass",
                        "totalUnassignedTime"
                    ],
                    "type": "object"
                }
            ]
        },
        "StmPriorityReadable": {
            "properties": {
                "priority": {
                    "type": "number"
                },
                "uuid": {
                    "type": "string"
                }
            },
            "required": [
                "priority",
                "uuid"
            ],
            "type": "object"
        }
    },
    "properties": {
        "_itemType": {
            "type": "string"
        },
        "actionOrderUuids": {
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "actionsReadable": {
            "items": {
                "$ref": "#/definitions/ExportAction"
            },
            "type": "array"
        },
        "calculatedFields": {
            "$ref": "#/definitions/PoiCalculatedFields"
        },
        "createdAt": {
            "type": "string"
        },
        "description": {
            "description": "The description of the POI, e.g. \"Mare Crisium\"",
            "type": "string"
        },
        "descriptionReadable": {
            "type": "string"
        },
        "elevation": {
            "type": [
                "null",
                "number"
            ]
        },
        "elevationRelative": {
            "type": "number"
        },
        "icon": {
            "description": "The emoji of this POI",
            "type": "string"
        },
        "iconEmojiDecoded": {
            "type": "string"
        },
        "location": {
            "anyOf": [
                {
                    "description": "Basic concept of a point",
                    "properties": {
                        "alt": {
                            "type": "number"
                        },
                        "lat": {
                            "type": "number"
                        },
                        "lng": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "lat",
                        "lng"
                    ],
                    "type": "object"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The coordinates or series of coordinates of the POI."
        },
        "missionId": {
            "type": "number"
        },
        "name": {
            "description": "The name of the POI, e.g. \"M-19\"",
            "type": "string"
        },
        "ownerId": {
            "type": "number"
        },
        "priorityOverride": {
            "description": "Priority of this POI.",
            "type": "number"
        },
        "radius": {
            "description": "The radius of this POI. (how close to the POI is considered \"at\" the POI)",
            "type": "number"
        },
        "status": {
            "anyOf": [
                {
                    "enum": [
                        "Approved",
                        "Archived",
                        "Candidate",
                        "In Review"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Status of this POI"
        },
        "tags": {
            "description": "Tags for this POI",
            "items": {
                "type": "string"
            },
            "type": "array"
        },
        "updatedAt": {
            "type": "string"
        },
        "uuid": {
            "description": "uuid of the POI",
            "type": "string"
        }
    },
    "required": [
        "_itemType",
        "actionOrderUuids",
        "actionsReadable",
        "calculatedFields",
        "description",
        "descriptionReadable",
        "elevation",
        "elevationRelative",
        "icon",
        "iconEmojiDecoded",
        "location",
        "missionId",
        "name",
        "ownerId",
        "priorityOverride",
        "radius",
        "status",
        "tags",
        "uuid"
    ],
    "type": "object"
}

