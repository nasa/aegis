{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Node Attach",
      "skipFiles": ["<node_internals>/**"],
      "port": 9229
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Chrome Attach",
      "port": 9222,
      "urlFilter": "http://aegis-local.fit.nasa.gov:4000/*",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "gdal: Remote Attach",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/server/python",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": true
    }
  ]
}
