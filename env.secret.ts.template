// Template for `env.secret.ts`.
//
// Copy this file to `env.secret.ts`, then run `npm run make-dotenv` to generate
// your local `.env`. AEGIS developers should instead get the real values from
// another developer (see README) — these placeholders are non-functional.
//
// What works with these placeholders:
//   - The app boots and runs for local development.
//   - Local login is bypassed because `local`/`test` set MOCK_USER=true, so the
//     Launchpad/OAuth values below are never actually used.
//
// What does NOT work with these placeholders:
//   - Box.com integration (admin zip downloads) — needs real BOX_* credentials.
//   - EMSS/Maestro app-to-app API — needs a real EMSS_TOKEN.
//   - Deploying to a public/shared environment — generate real secrets first.

export default {
  // Session/cookie crypto. Fine to leave for local dev; change for any shared host.
  OAUTH2_PROXY_COOKIE_SECRET: "localdevlocaldevlocaldevlocaldev",
  SESSION_PASSWORD: "localdevsessionlocaldevsession12",

  // Local Postgres password. Used both to initialize the docker DB and to connect
  // to it, so the value is self-consistent for local dev.
  DB_PASS: "aegislocaldev",

  // Super-admin password-reset key (passed as a URL param). Change for shared hosts.
  ADMIN_RECOVERY_KEY: "local-dev-recovery-key",

  // EMSS/Maestro app-to-app API token. Placeholder — EMSS integration disabled.
  EMSS_TOKEN: "local-dev-emss-token",

  // Box.com integration (admin zip downloads). Placeholders — Box features fail.
  BOX_CLIENT_ID: "box-client-id-placeholder",
  BOX_CLIENT_SECRET: "box-client-secret-placeholder",
  BOX_ENTERPRISE_ID: "0",
  BOX_USER_ID: "0",

  // Load-test user password. Only used by load tests.
  LOADTEST_PASSWORD: "local-dev-loadtest",

  // NASA Launchpad OAuth. Placeholders — login is bypassed locally by MOCK_USER=true.
  LAUNCHPAD_SANDBOX_CLIENT_ID: "launchpad-sandbox-client-id-placeholder",
  LAUNCHPAD_SANDBOX_CLIENT_SECRET: "launchpad-sandbox-client-secret-placeholder",
  LAUNCHPAD_PRODUCTION_CLIENT_ID: "launchpad-production-client-id-placeholder",
  LAUNCHPAD_PRODUCTION_CLIENT_SECRET: "launchpad-production-client-secret-placeholder",
};
