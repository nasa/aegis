# AEGIS local-dev environment template (public / open-source setup)
#
# Copy this file to `.env` to run AEGIS locally without NASA's internal tooling:
#   cp .env.template .env
#
# These are the same values `npm run make-dotenv` produces for the `local`
# environment, with all sensitive values replaced by non-functional placeholders.
# The app boots and the Apollo 14 demo works with these as-is because local login
# is bypassed (MOCK_USER=true). Box.com and EMSS/Maestro integrations do NOT work
# with the placeholders — supply real values only if you need those features.
#
# AEGIS developers with NASA access should instead use `npm run make-dotenv`
# (see README "First-Time Setup within NASA").

# ── Host directories ────────────────────────────────────────────────────────
DOCKER_SSL_CERTS_DIR="./.local/certs"
DOCKER_SSL_PRIVATE_DIR="./.local/private"
DOCKER_DB_DATA_DIR="./.local/database"
DOCKER_DB_INIT_DIR="./.local/db-init"
STATIC_DIR="../aegis_static"

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME="aegis"
DB_HOST="localhost"
DB_PORT="5432"
GDAL_HOST="localhost"
GDAL_PORT="4200"

# ── Container images (not used for native local dev) ────────────────────────
BASE_IMAGE_NAME="NOT_USED_LOCALLY"
IMAGE_VERSION="dev"
DOCKER_IMAGE_NGINX="NOT_USED_LOCALLY"
DOCKER_IMAGE_APIV1="NOT_USED_LOCALLY"
DOCKER_IMAGE_GDAL="NOT_USED_LOCALLY"

# ── Box.com integration (placeholder — admin zip downloads will not work) ────
BOX_INITIAL_FOLDER_ID="NOT_USED_LOCALLY"
BOX_CLIENT_ID="box-client-id-placeholder"
BOX_CLIENT_SECRET="box-client-secret-placeholder"
BOX_ENTERPRISE_ID="0"
BOX_USER_ID="0"

# ── Auth / Launchpad (bypassed locally by MOCK_USER=true) ───────────────────
MOCK_USER="true"
OAUTH2_PROXY_COOKIE_SECRET="localdevlocaldevlocaldevlocaldev"
OAUTH2_PROXY_OIDC_ISSUER_URL="NA"
OAUTH2_PROXY_LOGIN_URL="NA"
OAUTH2_PROXY_REDEEM_URL="NA"
OAUTH2_PROXY_OIDC_JWKS_URL="NA"
OAUTH2_PROXY_WHITELIST_DOMAIN="NA"
OAUTH2_PROXY_CLIENT_ID="NA"
OAUTH2_PROXY_CLIENT_SECRET="NA"
OAUTH2_PROXY_REDIRECT_URL="NA"

# ── EMSS/Maestro app-to-app API (placeholder — integration disabled) ────────
EMSS_TOKEN="local-dev-emss-token"

# ── Secrets (placeholders; self-consistent for local dev) ───────────────────
DB_PASS="aegislocaldev"
ADMIN_RECOVERY_KEY="local-dev-recovery-key"
SESSION_PASSWORD="localdevsessionlocaldevsession12"
LOADTEST_PASSWORD="local-dev-loadtest"

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_CACHE_DIR="./.local/redis"

# ── Logging (remote logging disabled locally) ───────────────────────────────
LOG_ENABLE_APP_LOGGING="false"
LOG_DATA_APP_ID="aegis"
LOG_DATA_SERVER_NAME="local-dev"
LOG_SERVER_HTTP_ENDPOINT="NOT_USED_LOCALLY"
LOG_INTERNAL_ENDPOINT="udp://127.0.0.1:514"
VITE_PUBLIC_CONSOLE_LOG_LEVEL="debug"
VITE_PUBLIC_REMOTE_LOG_LEVEL="off"
