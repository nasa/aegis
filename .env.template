
DB_HOST=${DB_HOST}
DB_NAME=aegis
# Do not need to specify a db port. AEGIS is special and gets to always use the default port

# The docker images to be used in docker compose when running in the pipeline. These
# values are not used locally.
DOCKER_IMAGE_NGINX=${DOCKER_IMAGE_NGINX}
DOCKER_IMAGE_GDAL=${DOCKER_IMAGE_GDAL}
DOCKER_IMAGE_APIV1=${DOCKER_IMAGE_APIV1}

# Location of SSL cert/key. For local dev, run `bash scripts/make-dev-ssl-cert.sh` to create a self-
# signed cert.
DOCKER_SSL_CERTS_DIR=${DOCKER_SSL_CERTS_DIR}
DOCKER_SSL_PRIVATE_DIR=${DOCKER_SSL_PRIVATE_DIR}

STATIC_DIR=${STATIC_DIR}
DOCKER_DB_DATA_DIR=${DOCKER_DB_DATA_DIR}
DOCKER_DB_INIT_DIR=${DOCKER_DB_INIT_DIR}

GDAL_HOST=${GDAL_HOST} 
GDAL_PORT=${GDAL_PORT} 

#
# !!!! SENSITIVE DATA !!!!
#
# The following env vars are sensitive! Do not send them to anyone who doesn't need them
# If sending them to someone who does need them, send via encrypted email.
#
# If you need values, request from AEGIS developers or copy from GitLab CI/CD variables. These values
# will be stored in .env.secret so make-dotenv.sh can reuse them.
#
DB_PASS=${DB_PASS}
# The key passed in as a URL param to an API endpoint to hard reset the super admin user password to the default
ADMIN_RECOVERY_KEY=${ADMIN_RECOVERY_KEY}
# session password to encrypt the cookie
SESSION_PASSWORD=${SESSION_PASSWORD}


# integration with box.com for admin zip downloads
# These values are from the box.com developer console.
# Currently using bf@benfeist.com Box account but could be done with any box account that has access to the AEGIS Zips folder and can create new apps.
BOX_CLIENT_ID=${BOX_CLIENT_ID}
BOX_CLIENT_SECRET=${BOX_CLIENT_SECRET}
BOX_ENTERPRISE_ID=${BOX_ENTERPRISE_ID}
BOX_USER_ID=${BOX_USER_ID}
BOX_INITIAL_FOLDER_ID=198245097840