{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:js-app"],
  "schedule": ["before 5am on monday"],
  "npm": {
    "minimumReleaseAge": "7 days"
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "labels": ["Renovate"],
  "packageRules": [
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "ESLint and plugins",
      "matchPackageNames": ["/eslint/"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "jest",
      "matchPackageNames": ["/jest/"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "mikro",
      "matchPackageNames": ["/mikro/"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "All patch updates",
      "matchUpdateTypes": ["patch"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "All minor updates",
      "matchUpdateTypes": ["minor"],
      "labels": ["Renovate"]
    },
    {
      "groupName": null,
      "matchUpdateTypes": ["major"],
      "excludePackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "excludePackagePatterns": ["/eslint/", "/jest/", "/mikro/"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "Infrastructure and CI updates",
      "matchManagers": ["dockerfile", "docker-compose", "gitlab-ci"],
      "labels": ["Renovate", "Infrastructure"]
    },
  ]
}
