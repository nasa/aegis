{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:js-app", ":maintainLockFilesWeekly"],
  "npm": {"minimumReleaseAge": "7 days"},
  "major": {"dependencyDashboardApproval": true},
  "labels": ["Renovate"],
  "packageRules": [
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "labels": ["Renovate"]
    },
    {
      "groupName": "ESLint",
      "labels": ["Renovate"],
      "matchPackageNames": ["/eslint/"]
    },
    {
      "groupName": "Jest",
      "labels": ["Renovate"],
      "matchPackageNames": ["/jest/"]
    },
    {
      "groupName": "Mikro",
      "labels": ["Renovate"],
      "matchPackageNames": ["/mikro/"]
    },
    {
      "groupName": "FontAwesome",
      "labels": ["Renovate"],
      "matchPackageNames": ["/fontawesome/", "/fortawesome/"]
    },
    {
      "groupName": "Playwright",
      "labels": ["Renovate"],
      "matchPackageNames": ["/playwright/"]
    },
    {
      "groupName": "All patch updates",
      "matchUpdateTypes": ["patch"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "All minor updates",
      "matchUpdateTypes": ["minor"],
      "labels": ["Renovate"]
    },
    {
      "groupName": "Infrastructure and CI updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "labels": ["Renovate", "ci"]
    }
  ]
}
