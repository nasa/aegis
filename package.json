{
  "name": "aegis-zero",
  "version": "0.1.9",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--inspect' next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "tsc": "tsc --pretty",
    "test": "jest --runInBand",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "npm run test       -- --coverage --reporters=default --reporters=jest-junit",
    "test:coverage:single": "npm run test       --  --coverage --reporters=default --reporters=jest-junit --collectCoverageFrom=[]",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "seed": "npx mikro-orm seeder:run",
    "migrate:up": "npx mikro-orm migration:up",
    "migrate:down": "npx mikro-orm migration:down",
    "migrate:create": "npx mikro-orm migration:create",
    "migrate:fresh": "npx mikro-orm migration:fresh --seed",
    "docker:dev": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml build --no-cache",
    "docker:preview": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml up --build -d",
    "docker:preview:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml build --no-cache",
    "version:patch": "npm version patch && git push",
    "version:minor": "npm version minor && git push",
    "version:major": "npm version major && git push"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.18.6",
    "@emoji-mart/data": "^1.1.2",
    "@emoji-mart/react": "^1.1.1",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-regular-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@fseehawer/react-circular-slider": "^2.6.1",
    "@mikro-orm/cli": "5.8.9",
    "@mikro-orm/core": "5.8.9",
    "@mikro-orm/migrations": "5.8.9",
    "@mikro-orm/postgresql": "5.8.9",
    "@mikro-orm/seeder": "5.8.9",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/react-color": "^3.0.7",
    "axios": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "cross-env": "^7.0.3",
    "final-form": "^4.20.10",
    "install": "^0.13.0",
    "iron-session": "^6.3.1",
    "is-hotkey": "^0.2.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-fetch-mock": "^3.0.3",
    "json-keys-sort": "^2.1.0",
    "leaflet": "^1.9.4",
    "leaflet-ant-path": "^1.3.0",
    "leaflet-draggable-lines": "^1.2.1",
    "leaflet-highlightable-layers": "^1.2.1",
    "leaflet-polylineoffset": "^1.1.1",
    "leaflet-textpath": "^1.2.3",
    "leaflet.tilelayer.colorfilter": "^1.2.5",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "next": "13.2.4",
    "next-connect": "^0.13.0",
    "next-redux-wrapper": "^8.1.0",
    "node-stream-zip": "^1.15.0",
    "npm": "^10.2.0",
    "paper": "^0.12.17",
    "proj4leaflet": "^1.0.2",
    "react": "^18.2.0",
    "react-checkbox-tree": "^1.8.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-drag-listview": "^2.0.0",
    "react-final-form": "^6.5.9",
    "react-redux": "^8.1.3",
    "react-select": "^5.7.7",
    "react-tag-input-component": "^2.0.2",
    "react-tooltip": "^5.21.5",
    "slate-react": "^0.99.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "string-strip-html": "^13.4.3",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.23.2",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@types/bcryptjs": "^2.4.4",
    "@types/jest": "^29.5.5",
    "@types/leaflet": "^1.9.6",
    "@types/leo-profanity": "^1.5.1",
    "@types/lodash": "^4.14.199",
    "@types/multer": "^1.4.8",
    "@types/node": "^20.8.6",
    "@types/node-fetch": "2.6.6",
    "@types/proj4leaflet": "^1.0.8",
    "@types/react": "18.2.28",
    "@types/react-dom": "18.2.13",
    "@types/react-redux": "^7.1.27",
    "@types/uuid": "^9.0.5",
    "@types/webpack-env": "^1.18.2",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "eslint": "^8.51.0",
    "eslint-config-next": "13.5.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-transform-css": "^6.0.1",
    "node-mocks-http": "^1.13.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2"
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.orm.json",
    "configPaths": [
      "mikro-orm.config.ts"
    ]
  }
}
