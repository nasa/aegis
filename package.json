    "@mikro-orm/postgresql": "6.6.9",
    "@mikro-orm/seeder": "6.6.9",
    "bcryptjs": "3.0.3",
    "deep-diff": "1.0.2",
    "dotenv": "17.3.1",
    "pg-copy-streams": "7.0.0",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "ws": "8.19.0"
