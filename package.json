    "wait-on": "9.0.10"
  },
  "optionalDependencies": {
    "@emss/logger": "0.12.0",
    "@emss/make-dotenv": "0.6.0",
    "@emss/oauth2-proxy-backend": "0.8.0",
    "@emss/oauth2-proxy-frontend": "0.4.0",
    "@emss/utils": "0.7.0"
  },
  "mikro-orm": {
    "preferTs": true,
    "tsConfigPath": "./src/server/database/tsconfig.orm.json",
    "configPaths": [
      "./src/server/database/mikro-orm.config.ts"
    ]
  }
}
