{
  "name": "aegis-zero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--inspect' next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "tsc": "tsc --pretty",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "seed": "npx mikro-orm seeder:run",
    "migrate:up": "npx mikro-orm migration:up",
    "migrate:down": "npx mikro-orm migration:down",
    "docker:dev": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.dev.yml build --no-cache",
    "docker:preview": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml up --build -d",
    "docker:preview:rebuild": "cross-env DOCKER_SCAN_SUGGEST=false docker-compose -f docker-compose.yml -f docker-compose.preview.yml build --no-cache"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.18.6",
    "@fortawesome/fontawesome-svg-core": "^6.3.0",
    "@fortawesome/free-regular-svg-icons": "^6.1.1",
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@mikro-orm/cli": "5.5.2",
    "@mikro-orm/core": "5.5.2",
    "@mikro-orm/migrations": "5.5.2",
    "@mikro-orm/postgresql": "5.5.2",
    "@mikro-orm/seeder": "5.5.2",
    "@react-leaflet/core": "^2.0.0",
    "@reduxjs/toolkit": "^1.8.3",
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "cross-env": "^7.0.3",
    "iron-session": "^6.3.1",
    "jest-fetch-mock": "^3.0.3",
    "leaflet": "^1.9.3",
    "leaflet-ant-path": "^1.3.0",
    "leaflet-draggable-lines": "^1.2.0",
    "leaflet-highlightable-layers": "^1.2.1",
    "leaflet.tilelayer.colorfilter": "^1.2.5",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "next": "12.2.2",
    "next-connect": "^0.13.0",
    "next-redux-wrapper": "^7.0.5",
    "node-stream-zip": "^1.15.0",
    "paper": "^0.12.15",
    "pg-hstore": "^2.3.4",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-checkbox-tree": "^1.8.0",
    "react-contenteditable": "^3.3.6",
    "react-dom": "^18.2.0",
    "react-drag-listview": "^2.0.0",
    "react-range": "^1.8.14",
    "react-redux": "^8.0.5",
    "react-slider": "^2.0.1",
    "react-tag-input-component": "^2.0.2",
    "react-tooltip": "^5.5.2",
    "redux-mock-store": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^10.9.1",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.19.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.0.1",
    "@types/leaflet": "^1.7.11",
    "@types/leaflet-draw": "^1.0.5",
    "@types/lodash": "^4.14.182",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.0.6",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "@types/react-redux": "^7.1.25",
    "@types/validator": "^13.7.6",
    "@types/webpack-env": "^1.18.0",
    "@typescript-eslint/eslint-plugin": "^5.30.7",
    "eslint": "8.20.0",
    "eslint-config-next": "12.2.2",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.3",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.0.3",
    "jest-junit": "^14.0.1",
    "jest-transform-css": "^6.0.0",
    "next-router-mock": "^0.7.4",
    "node-mocks-http": "^1.11.0",
    "prettier": "^2.7.1",
    "prettier-eslint": "^15.0.1",
    "rimraf": "^3.0.2",
    "ts-jest": "^28.0.8",
    "typescript": "4.7.4"
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.orm.json",
    "configPaths": [
      "mikro-orm.config.ts"
    ]
  }
}
