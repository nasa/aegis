{
  "name": "aegis",
  "version": "1.1.5",
  "private": true,
  "scripts": {
    "dev": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api:dev\"",
    "build": "npm run vite:build && npm run api:build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc --pretty",
    "test": "jest --config ./src/tests/jest/jest.config.ts --maxWorkers 50%",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test && npm run test:playwright",
    "test:coverage": "jest --config ./src/tests/jest/jest.config.ts --coverage --reporters=default --reporters=jest-junit  --maxWorkers 50%",
    "test:playwright": "playwright test --config=./src/tests/playwright/playwright.config.ts",
    "test:playwright:ci": "playwright test --config=./src/tests/playwright/playwright.config.ts --shard=$SHARD_INDEX/$NUM_SHARDS",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "seed": "npx mikro-orm seeder:run",
    "migrate:up": "npx mikro-orm migration:up",
    "migrate:down": "npx mikro-orm migration:down",
    "migrate:create": "npx mikro-orm migration:create && npx prettier --write ./src/server/database/migrations/Migration20*.ts --ignore-path .prettierignore",
    "migrate:fresh": "npx mikro-orm migration:fresh --seed",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "vite:dev:wait": "wait-on http://localhost:4001/api/v1/health && vite",
    "api:build": "npm run schema:create && node esbuild.mjs",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "rimraf ./.local/express/dist && concurrently -n build,serve \"npm run api:build:watch\" \"wait-on ./.local/express/dist/api.js && nodemon  --enable-source-maps --inspect=8229 --legacy-watch --watch ./.local/express/dist ./.local/express/dist/api.js ./src/server\"",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js",
    "docker:services": "bash ./appcompose services up -d",
    "docker:services:rebuild": "bash ./appcompose services build",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview build",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "version:patch": "npm version patch && git push",
    "version:minor": "npm version minor && git push",
    "version:major": "npm version major && git push",
    "make-dotenv": "make-dotenv && npx prettier --write ./env.secret.ts --ignore-path .prettierignore",
    "schema:create": "concurrently -n action,station,poi,eva,mission,sublayerImportable \"npm run schema:create:action\" \"npm run schema:create:station\" \"npm run schema:create:poi\" \"npm run schema:create:eva\" \"npm run schema:create:mission\" \"npm run schema:create:sublayerImportable\"",
    "schema:create:action": "typescript-json-schema ./tsconfig.schema.json ExportAction --noExtraProps --required --ignoreErrors -o ./.local/schemas/exportAction.json",
    "schema:create:station": "typescript-json-schema ./tsconfig.schema.json ExportStation --noExtraProps --required --ignoreErrors -o ./.local/schemas/exportStation.json",
    "schema:create:eva": "typescript-json-schema ./tsconfig.schema.json ExportEva --noExtraProps --required --ignoreErrors -o ./.local/schemas/exportEva.json",
    "schema:create:poi": "typescript-json-schema ./tsconfig.schema.json ExportPOI --noExtraProps --required --ignoreErrors -o ./.local/schemas/exportPoi.json",
    "schema:create:mission": "typescript-json-schema ./tsconfig.schema.json Mission --noExtraProps --required --ignoreErrors -o ./.local/schemas/exportMission.json",
    "schema:create:sublayerImportable": "typescript-json-schema ./tsconfig.schema.json SublayerImportable --noExtraProps --required --ignoreErrors -o ./.local/schemas/sublayerImportable.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@emss/logger": "^0.7.1",
    "@emss/make-dotenv": "^0.3.2",
    "@emss/oauth2-proxy-backend": "^0.5.0",
    "@emss/oauth2-proxy-frontend": "^0.2.9",
