{
  "name": "aegis-zero",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api:dev\"",
    "build": "npm run vite:build && npm run api:build",
    "lint": "eslint .",
    "tsc": "tsc --pretty",
    "test": "jest --maxWorkers 50%",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test && npm run test:playwright",
    "test:coverage": "jest --coverage --reporters=default --reporters=jest-junit  --maxWorkers 50%",
    "test:playwright": "playwright test",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "seed": "npx mikro-orm seeder:run",
    "migrate:up": "npx mikro-orm migration:up",
    "migrate:down": "npx mikro-orm migration:down",
    "migrate:create": "npx mikro-orm migration:create",
    "migrate:fresh": "npx mikro-orm migration:fresh --seed",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "vite:dev:wait": "wait-on http://localhost:4001/api/v1/health && vite",
    "api:build": "node esbuild.mjs",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "rimraf ./.local/express/dist && concurrently -n build,serve \"npm run api:build:watch\" \"wait-on ./.local/express/dist/api.js && nodemon  --enable-source-maps --inspect=8229 --legacy-watch --watch ./.local/express/dist ./.local/express/dist/api.js ./src/server\"",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js",
    "docker:services": "bash ./appcompose services up -d database gdal",
    "docker:services:rebuild": "bash ./appcompose services build database gdal",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache database gdal",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview build",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "version:patch": "npm version patch && git push",
    "version:minor": "npm version minor && git push",
    "version:major": "npm version major && git push",
    "make-dotenv": "make-dotenv"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@emss/make-dotenv": "^0.3.2",
    "@emss/oauth2-proxy-backend": "^0.3.2",
    "@emss/oauth2-proxy-frontend": "^0.2.8",
    "@eslint/compat": "^1.2.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@fseehawer/react-circular-slider": "^2.7.0",
    "@mikro-orm/cli": "6.3.13",
    "@mikro-orm/core": "6.3.13",
    "@mikro-orm/migrations": "6.3.13",
    "@mikro-orm/postgresql": "6.3.13",
    "@mikro-orm/seeder": "6.3.13",
    "@reduxjs/toolkit": "^2.2.8",
    "@turf/helpers": "^7.1.0",
    "@turf/square-grid": "^7.1.0",
    "@turf/turf": "^7.1.0",
    "@types/json-logic-js": "^2.0.7",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "box-node-sdk": "^3.7.1",
    "color": "^4.2.3",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "final-form": "^4.20.10",
    "fontfaceobserver": "^2.3.0",
    "is-hotkey": "^0.2.0",
    "json-keys-sort": "^2.1.0",
    "json-logic-js": "^2.0.5",
    "leaflet": "^1.9.4",
    "leaflet-ant-path": "^1.3.0",
    "leaflet-draggable-lines": "^3.2.0",
    "leaflet-highlightable-layers": "^3.0.1",
    "leaflet-polylinedecorator": "^1.6.0",
    "leaflet-vector-tile-layer": "^0.16.1",
    "leaflet.tilelayer.colorfilter": "^1.2.5",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
