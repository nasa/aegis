{
  "name": "aegis-zero",
  "version": "1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n vite,api \"npm run vite:dev\" \"npm run api:dev\"",
    "build": "vite build --emptyOutDir && npm run api:build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx ./src",
    "tsc": "tsc --pretty",
    "test": "jest",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test",
    "test:coverage": "npm run test       -- --coverage --reporters=default --reporters=jest-junit",
    "test:coverage:single": "npm run test       --  --coverage --reporters=default --reporters=jest-junit --collectCoverageFrom=[]",
    "postinstall": "rimraf node_modules/paper/dist/docs",
    "seed": "npx mikro-orm seeder:run",
    "migrate:up": "npx mikro-orm migration:up",
    "migrate:down": "npx mikro-orm migration:down",
    "migrate:create": "npx mikro-orm migration:create",
    "migrate:fresh": "npx mikro-orm migration:fresh --seed",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "api:build": "rimraf ./.local/express/dist && esbuild --sourcemap ./src/server/express/server.ts --bundle --format=cjs --platform=node --external:@mikro-orm/mongodb --external:@mikro-orm/mysql --external:@mikro-orm/mariadb --external:@mikro-orm/sqlite --external:@mikro-orm/better-sqlite --external:@mikro-orm/entity-generator --external:sqlite3 --external:mysql --external:mysql2 --external:better-sqlite3 --external:oracledb --external:pg-query-stream --external:tedious --outfile=./.local/express/dist/api.js",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "concurrently -n build,serve \"npm run api:build:watch\" \"wait-on ./.local/express/dist/api.js && nodemon  --enable-source-maps --inspect=8229 --legacy-watch --watch ./.local/express/dist ./.local/express/dist/api.js ./src/server\"",
    "api:prod": "cross-env NODE_ENV=production node ./.local/express/dist/api.js",
    "docker:services": "bash ./appcompose services up -d database gdal",
    "docker:services:rebuild": "bash ./appcompose services build database gdal",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache database gdal",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview build",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "version:patch": "npm version patch && git push",
    "version:minor": "npm version minor && git push",
    "version:major": "npm version major && git push"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.1.2",
    "@emoji-mart/react": "^1.1.1",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@fseehawer/react-circular-slider": "^2.6.4",
    "@mikro-orm/cli": "6.1.11",
    "@mikro-orm/core": "6.1.11",
    "@mikro-orm/migrations": "6.1.11",
    "@mikro-orm/postgresql": "^6.1.11",
    "@mikro-orm/seeder": "6.1.11",
    "@reduxjs/toolkit": "^2.2.1",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "box-node-sdk": "^3.5.0",
    "color": "^4.2.3",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.20.2",
    "express": "^4.19.0",
    "express-session": "^1.18.0",
    "final-form": "^4.20.10",
    "fontfaceobserver": "^2.3.0",
    "install": "^0.13.0",
    "is-hotkey": "^0.2.0",
    "json-keys-sort": "^2.1.0",
    "leaflet": "^1.9.4",
    "leaflet-ant-path": "^1.3.0",
    "leaflet-draggable-lines": "^2.0.0",
    "leaflet-highlightable-layers": "^3.0.0",
    "leaflet-polylinedecorator": "^1.6.0",
    "leaflet.tilelayer.colorfilter": "^1.2.5",
    "leo-profanity": "^1.7.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "node-stream-zip": "^1.15.0",
    "paper": "^0.12.17",
    "pretty-bytes": "^6.1.1",
    "proj4leaflet": "^1.0.2",
    "react": "^18.2.0",
    "react-checkbox-tree": "^1.8.0",
    "react-color": "^2.19.3",
    "react-cookie": "^7.1.0",
    "react-dom": "^18.2.0",
    "react-drag-listview": "^2.0.0",
    "react-final-form": "^6.5.9",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.3",
    "react-select": "^5.8.0",
    "react-tag-input-component": "^2.0.2",
    "react-tooltip": "5.26.3",
    "rimraf": "^5.0.5",
    "slate-react": "^0.102.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "string-strip-html": "^13.4.6",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.1",
    "vite": "^5.2.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/color": "^3.0.6",
    "@types/cookie-session": "^2.0.48",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.8",
    "@types/leaflet-polylinedecorator": "^1.6.4",
    "@types/leo-profanity": "^1.5.3",
    "@types/lodash": "^4.17.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.30",
    "@types/node-fetch": "2.6.11",
    "@types/proj4leaflet": "^1.0.10",
    "@types/react": "18.2.67",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "18.2.22",
    "@types/react-redux": "^7.1.33",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "box-typescript-sdk-gen": "^0.5.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-junit": "^16.0.0",
    "jest-transform-css": "^6.0.1",
    "node-mocks-http": "^1.14.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "user-agent-data-types": "^0.4.2",
    "vite-plugin-progress": "^0.0.7",
    "vite-tsconfig-paths": "^4.3.2",
    "wait-on": "^7.2.0"
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.orm.json",
    "configPaths": [
      "mikro-orm.config.ts"
    ]
  }
}
