{
  "name": "aegis",
  "version": "1.2.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "scripts": {
    "bom": "docker run -it -v .:/repo -w /repo --name node-sbom --rm eegitlabregistry.fit.nasa.gov/emss/docker-images/node-ci:sbom /make-sbom.sh",
    "dev": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api:dev\"",
    "dev:ci": "concurrently -n vite,api \"npm run vite:dev:wait\" \"npm run api\"",
    "build": "npm run vite:build && npm run api:build",
    "lint": "concurrently -n js,css \"npm run lint:js\" \"npm run lint:css\"",
    "lint:fix": "concurrently -n js,css \"npm run lint:js:fix\" \"npm run lint:css:fix\"",
    "lint:js": "eslint . --color",
    "lint:js:fix": "eslint . --fix --color",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "postinstall": "rimraf node_modules/paper/dist/paperjs/docs && rimraf node_modules/paper/dist/docs",
    "tsc": "tsc --pretty",
    "test:vitest": "vitest run --config src/tests/vitest/vitest.config.mts",
    "test:all": "npm run lint && npm run tsc && npm run build && npm run test:vitest",
    "test:coverage": "vitest run --coverage --config src/tests/vitest/vitest.config.mts",
    "test:playwright": "playwright test --config=./src/tests/playwright/playwright.config.ts",
    "test:playwright:ci": "playwright test --config=./src/tests/playwright/playwright.config.ts --shard=$SHARD_INDEX/$NUM_SHARDS",
    "test:playwright:ui": "playwright test --config ./src/tests/playwright/playwright.config.ts --ui",
    "test:automerge:migration": "npm run schema:create && npm run automerge:migration:build && npm run automerge:migration",
    "test:loadtest:build": "node ./src/tests/loadTest/esbuild.loadtest.mjs",
    "test:loadtest": "node ./.local/express/dist/loadTest/startLoadTest.js",
    "seed": "npx mikro-orm seeder:run",
    "migration:up": "npx mikro-orm migration:up",
    "migration:down": "npx mikro-orm migration:down",
    "migration:create": "npx mikro-orm migration:create && npx prettier --write ./src/server/database/migrations/Migration20*.ts --ignore-path .prettierignore",
    "migration:fresh": "npx mikro-orm migration:fresh --seed",
    "vite:build": "vite build --emptyOutDir",
    "vite:dev": "vite",
    "vite:dev:debug": "vite dev --debug",
    "vite:dev:wait": "wait-on http://localhost:4001/api/v1/health && vite",
    "api:build": "npm run schema:create && npm run automerge:migration:build && node esbuild.mjs ",
    "api:build:watch": "npm run api:build -- --watch",
    "api:dev": "rimraf ./.local/express/dist && concurrently -n build,serve \"npm run api:build:watch\" \"wait-on ./.local/express/dist/api/api.js && nodemon  --enable-source-maps --inspect=8229 --legacy-watch --watch ./.local/express/dist ./.local/express/dist/api/api.js ./src/server\"",
    "api": "node ./.local/express/dist/api/api.js",
    "docker:services": "bash ./appcompose services up -d",
    "docker:services:rebuild": "bash ./appcompose services build",
    "docker:services:rebuild:nocache": "bash ./appcompose services build --no-cache",
    "docker:preview": "bash ./appcompose preview up -d",
    "docker:preview:rebuild": "bash ./appcompose preview build",
    "docker:preview:rebuild:nocache": "bash ./appcompose preview build --no-cache",
    "version:patch": "npm version patch && git push",
    "version:minor": "npm version minor && git push",
    "version:major": "npm version major && git push",
    "make-dotenv": "make-dotenv && npx prettier --write ./env.secret.ts --ignore-path .prettierignore",
    "schema:create": "concurrently \"npm run schema:create:sublayerImportable\" \"npm run schema:create:rexOverwrite\" \"npm run schema:create:mission\"",
    "schema:create:sublayerImportable": "typescript-json-schema ./tsconfig.schema.json SublayerImportable --noExtraProps --required --ignoreErrors -o ./.local/schemas/sublayerImportable.json",
    "schema:create:rexOverwrite": "typescript-json-schema ./tsconfig.schema.json RexOverwrite --noExtraProps --required --ignoreErrors -o ./.local/schemas/rexOverwrite.json",
    "schema:create:mission": "typescript-json-schema ./tsconfig.schema.json Mission --noExtraProps --required --ignoreErrors -o ./.local/schemas/mission.json",
    "automerge:migration:build": "node ./src/server/automerge/esbuild.automerge.mjs",
    "automerge:migration": "node ./.local/automerge/dist/migration.js"
  },
  "dependencies": {
    "@automerge/automerge": "3.2.4",
    "@automerge/automerge-repo": "2.5.3",
    "@automerge/automerge-repo-network-websocket": "2.5.3",
    "@automerge/automerge-repo-react-hooks": "2.5.3",
    "@mikro-orm/cli": "6.6.9",
    "@mikro-orm/core": "6.6.9",
