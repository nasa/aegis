    "node-stream-zip": "^1.15.0",
    "paper": "^0.12.18",
    "pg": "^8.13.0",
    "pretty-bytes": "^6.1.1",
    "proj4leaflet": "^1.0.2",
    "react": "^18.3.1",
    "react-checkbox-tree": "^1.8.0",
    "react-color": "^2.19.3",
    "react-cookie": "^7.2.1",
    "react-dom": "^18.3.1",
    "react-drag-listview": "^2.0.0",
    "react-final-form": "^6.5.9",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "react-select": "^5.8.1",
    "react-tag-input-component": "^2.0.2",
    "react-tooltip": "5.28.0",
    "slate-react": "^0.110.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "string-strip-html": "^13.4.8",
    "ts-node": "^10.9.2",
    "unique-names-generator": "^4.7.1",
    "use-window-size-v2": "^2.2.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/aria-query": "^5.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/color": "^3.0.6",
    "@types/cookie-session": "^2.0.49",
    "@types/express-session": "^1.18.0",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/geojson": "^7946.0.14",
    "@types/is-hotkey": "^0.1.10",
    "@types/jest": "^29.5.13",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet-polylinedecorator": "^1.6.4",
    "@types/leo-profanity": "^1.5.4",
    "@types/lodash": "^4.17.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/proj4leaflet": "^1.0.10",
    "@types/react": "18.3.11",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "18.3.1",
    "@types/react-redux": "^7.1.34",
    "@types/react-test-renderer": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-junit": "^16.0.0",
    "jest-transform-css": "^6.0.1",
    "node-mocks-http": "^1.16.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.5.4",
    "user-agent-data-types": "^0.4.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./src/server/database/tsconfig.orm.json",
    "configPaths": [
      "./src/server/database/mikro-orm.config.ts"
    ]
  }
}
